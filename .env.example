# Copy the keys you need into .env — never commit .env itself.

# ── Production data on free plan ─────────────────────────────────────────────
# Local mode uses data/*.xlsx, data/*.json, data/portal.db and data/uploads.
# Supabase mode stores member/project data in Postgres and project files in
# Supabase Storage, which is safer for free hosts with temporary disks.
DATA_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nspa-files
DOCUMENT_MAX_MB=25

# ── Metal prices (MetalpriceAPI) ─────────────────────────────────────────────
METALPRICE_API_KEY=

# ── Membership payments (Zeffy) ──────────────────────────────────────────────
ZEFFY_STUDENT_URL=
ZEFFY_REGULAR_URL=
# Optional. Comma-separated school email domains accepted for student verification.
# Leave blank to accept any school email a member can verify by code.
STUDENT_EMAIL_DOMAINS=

# ── Access ───────────────────────────────────────────────────────────────────
# Comma-separated staff emails allowed into the admin views.
ADMIN_EMAILS=
# Used in links inside outgoing email; set this to the real site URL in production.
APP_BASE_URL=http://localhost:3000
# Main public Wix website. Shows as "Website" in the app nav when set.
WIX_SITE_URL=
# Wix member-login page. Used by "Member Login" when set.
WIX_MEMBER_LOGIN_URL=
# Wix can read app links from:
#   APP_BASE_URL/api/wix/links
# Signs the session cookie. Set a long random value in production.
SESSION_SECRET=

# ── Outbound email (MailerSend) ──────────────────────────────────────────────
# Email is sent over the MailerSend HTTPS API. SMTP is not supported: the hosts
# this runs on block outbound ports 25/465/587, so SMTP times out silently.
#
# MailerSend rather than Resend because prospectors.ns.ca has its DNS on Wix,
# and Wix cannot create MX records on a subdomain. Resend's domain
# verification requires one, so it can never verify while DNS stays on Wix.
# MailerSend authenticates with records Wix does support.
#
# Both variables below are REQUIRED for email to be sent. With them unset the
# app still works — claim and membership alerts stay in-app instead of also
# being emailed — and the startup log says so plainly.
#
# Setup (free tier: 3,000 emails/month):
#   1. Create an account at https://mailersend.com.
#   2. Domains → Add domain → prospectors.ns.ca. MailerSend shows the DNS
#      records to add; in the Wix DNS panel add:
#        · the SPF TXT record at the root, MERGED into the existing Google
#          Workspace one — a domain may have only ONE SPF record, so the result
#          should read:
#            v=spf1 include:_spf.google.com include:_spf.mailersend.net ~all
#        · the two DKIM CNAME records
#        · the Return-Path CNAME record
#      No MX record is needed, and the existing Google Workspace MX records
#      must be left exactly as they are — they carry the association's inbound
#      mail.
#   3. Wait for the domain to show as verified in MailerSend.
#   4. API tokens → Create token, permission "Email full access". Copy it once —
#      it is shown only at creation — and paste it below.
#   5. Set MAIL_FROM to an address on the verified domain. The
#      "Name <address>" form is fine.
#
# Starts with mlsn. Keep it out of version control; .env is gitignored.
MAILERSEND_API_KEY=
# Must be on a domain authenticated in MailerSend, or sending is refused (422).
MAIL_FROM=NSPA <no-reply@prospectors.ns.ca>

# ── Optional AI advisory summaries for claim opportunity matches ─────────────
# Without OPENAI_API_KEY, the app still shows deterministic summaries/ranking.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Verify email after filling the above in:
#   npm test                        # transport tests, no key or network needed
#   restart the server — it logs "✓ Email ready via MailerSend HTTPS API" — then,
#   signed in as an address listed in ADMIN_EMAILS:
#   curl -X POST http://localhost:3000/api/admin/mail/test \
#        -H 'Content-Type: application/json' -b cookies.txt \
#        -d '{"to":"you@example.com"}'

# ── Claim watch (optional tuning) ────────────────────────────────────────────
# CLAIM_WATCH=off                     # disable the sweep entirely
# CLAIM_EXPIRY_DAYS=90,60,30,14,7,0   # expiry warning thresholds
# CLAIM_ANNIVERSARY_DAYS=90,60,30,14,7,0
# CLAIM_OPEN_GROUND_DAYS=90           # how far ahead to watch for ground opening
# CLAIM_OPEN_GROUND_BUFFER_DEG=0.02   # search radius around claims (~1.5-2 km)

# ── Backups ──────────────────────────────────────────────────────────────────
# A backup runs nightly and is emailed to ADMIN_EMAILS (needs MAILERSEND_API_KEY above).
# Archives are also kept on the data disk under backups/.
# BACKUPS=off                          # disable the nightly backup
# BACKUP_KEEP=7                        # how many archives of each kind to keep
# BACKUP_EMAIL_MAX_BYTES=20971520      # skip emailing archives larger than this
